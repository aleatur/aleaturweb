{
  "name": "aleatur-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/prepare-product-pages.mjs",
    "preview": "vite preview",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "validate:catalog": "node scripts/validate-catalog-assets.mjs",
    "test:catalog": "node --test tests/catalog-sync.test.mjs tests/home-page.test.mjs tests/catalog-query.test.mjs",
    "test:metadata": "node --test tests/product-pages.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "generate:images": "node scripts/generate-product-images.mjs",
    "validate:images": "node scripts/validate-product-images.mjs",
    "test:images": "node --test tests/product-images.test.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "sharp": "0.35.4"
  }
}
